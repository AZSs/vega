    <node id="印斯茅斯">
      <data key="d0">印斯茅斯</data>
      <data key="d1">location</data>
      <data key="d2">印斯茅斯是克苏鲁神话中虚构的马萨诸塞州海边小镇，以深潜者聚居地闻名。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="米·戈">
      <data key="d0">米·戈</data>
      <data key="d1">character</data>
      <data key="d2">米·戈是克苏鲁神话中的外星种族，具有真菌特征，来自犹格斯星。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
