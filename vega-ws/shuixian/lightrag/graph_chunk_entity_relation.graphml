    </node>
    <node id="私塾">
      <data key="d0">私塾</data>
      <data key="d1">item</data>
      <data key="d2">张观甲开设的教书场所，教导孩子们儒学和修仙。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033</data>
