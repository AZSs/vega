    <node id="夜明珠">
      <data key="d0">夜明珠</data>
      <data key="d1">item</data>
      <data key="d2">主室中的照明装置，被机关触发后会爆发出如同小太阳一般的亮度。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-004</data>
