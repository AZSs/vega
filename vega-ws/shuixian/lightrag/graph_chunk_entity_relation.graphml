    </edge>
    <edge source="陆阳" target="五行法术">
      <data key="d8">1.0</data>
      <data key="d9">陆阳误打误撞学会五行法术，用于钻地。</data>
      <data key="d10">掌握</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-024</data>
