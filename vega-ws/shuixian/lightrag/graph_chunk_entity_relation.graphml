    <edge source="陆阳" target="密室">
      <data key="d8">1.0</data>
      <data key="d9">陆阳在教主引导下进入密室，准备接受不朽仙人的祝福。</data>
      <data key="d10">进入</data>
      <data key="d11">doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-025</data>
