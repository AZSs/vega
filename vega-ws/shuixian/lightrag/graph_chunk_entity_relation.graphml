    <edge source="不朽仙子" target="兑换券">
      <data key="d8">1.0</data>
      <data key="d9">不朽仙子花光所有贡献点兑换兑换券，用于申请当三天宗主。</data>
      <data key="d10">兑换使用</data>
      <data key="d11">doc-8cd11b1c29c0a50ae046f374148d440b-chunk-025</data>
