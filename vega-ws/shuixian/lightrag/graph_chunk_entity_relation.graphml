      <data key="d14" />
    </edge>
    <edge source="师父" target="云芝">
      <data key="d8">1.0</data>
      <data key="d9">云芝是师父的弟子，受师父嘱托准备拜师事宜并教导陆阳。</data>
      <data key="d10">师徒,弟子</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="师父" target="师祖">
      <data key="d8">1.0</data>
      <data key="d9">师祖是师父的师父，作为拜师仪式的见证者。</data>
      <data key="d10">传承,师徒</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="傀儡" target="云芝">
      <data key="d8">2.0</data>
      <data key="d9">云芝留下傀儡监督陆阳的炼体训练。&lt;SEP&gt;云芝拥有并控制高智慧傀儡，傀儡负责做饭和陪伴陆阳。</data>
      <data key="d10">使用,拥有,控制,监督</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-025</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473531</data>
      <data key="d14" />
    </edge>
    <edge source="傀儡" target="陆阳">
      <data key="d8">6.0</data>
      <data key="d9">傀儡在陆阳眼睛成斗鸡眼时打了他两巴掌使其恢复正常，并推来一推车豆腐。&lt;SEP&gt;傀儡在训练中监督陆阳，并在其疲惫时喂食大补丹以维持训练。&lt;SEP&gt;陆阳与傀儡交手修炼，但被傀儡打败，挫败感倍增。&lt;SEP&gt;傀儡指导陆阳使用夔牛大腿做烧烤，并透露云芝的喜好。&lt;SEP&gt;傀儡指导陆阳切割夔牛和烹饪，并在陆阳灵力耗尽时喂给他大还丹。&lt;SEP&gt;傀儡在阵法外守护陆阳晋升，见其成功后离开。</data>
      <data key="d10">交手,交流,修炼,喂药,喂食,守护,帮助,指导,照顾,监督</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-022&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-025&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-026&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-013&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-008</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473745</data>
      <data key="d14" />
    </edge>
    <edge source="傀儡" target="孟景舟">
      <data key="d8">2.0</data>
      <data key="d9">孟景舟找陆阳时被傀儡赶走。&lt;SEP&gt;孟景舟识破对方打着飞天棍的名号推销傀儡，感到不满。</data>
      <data key="d10">不满,识破,赶走</data>
