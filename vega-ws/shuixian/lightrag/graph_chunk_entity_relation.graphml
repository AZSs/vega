      <data key="d14" />
    </edge>
    <edge source="陆阳" target="药王灵液">
      <data key="d8">1.0</data>
      <data key="d9">陆阳认为三百贡献点买不起药王灵液，药王灵液分为普通版和豪华版。</data>
      <data key="d10">价值,对比</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-030</data>
      <data key="d12">unknown_source</data>
