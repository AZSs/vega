      <data key="d6" />
    </node>
    <node id="天启">
      <data key="d0">天启</data>
      <data key="d1">character</data>
      <data key="d2">一位强大的存在，在故事中扮演重要角色，拥有超凡的力量和影响力。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-025</data>
