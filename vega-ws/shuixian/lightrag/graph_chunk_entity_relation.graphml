    <node id="金丹组">
      <data key="d0">金丹组</data>
      <data key="d1">concept</data>
      <data key="d2">问道宗和五行宗较量中的四个大组之一，罗海师兄在此组比赛中出场。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-019</data>
