    <node id="门户山岳">
      <data key="d0">门户山岳</data>
      <data key="d1">location</data>
      <data key="d2">问道宗的山岳，直通天际，被阳光镀上淡金，是护宗大阵的所在。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-002</data>
