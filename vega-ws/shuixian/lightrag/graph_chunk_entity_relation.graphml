    <node id="地狱">
      <data key="d0">地狱</data>
      <data key="d1">location</data>
      <data key="d2">地狱是恶魔的领域，阿兹莫丹和迪亚波罗等魔王在此统治。</data>
      <data key="d3">doc-dcc4b221c37bbee6881460ac6550c181-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473378</data>
