    <node id="问道宗三才">
      <data key="d0">问道宗三才</data>
      <data key="d1">faction</data>
      <data key="d2">由陆阳、蛮骨、孟景舟组成的战斗组合，共同对抗虎妖。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-010</data>
