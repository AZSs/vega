      <data key="d0">尚家小姐</data>
      <data key="d1">character</data>
      <data key="d2">尚家家主的女儿，因鹦鹉丢失而郁郁寡欢，喜欢在窗边看书，受到太平乡许多少年的迷恋。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="黄乡正">
      <data key="d0">黄乡正</data>
      <data key="d1">character</data>
      <data key="d2">姓黄的乡正，与尚家家主交好，向陆阳和桃夭叶介绍章管家的身份。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-036</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
