    <edge source="蛮骨" target="陆阳">
      <data key="d7">1.0</data>
      <data key="d8">陆阳与蛮骨同期修炼，蛮骨已引气入体，陆阳仍在炼体。</data>
      <data key="d9">同期,比较</data>
      <data key="d10">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-022</data>
