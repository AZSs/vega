    <edge source="不朽教" target="牛莽">
      <data key="d8">1.0</data>
      <data key="d9">牛莽参加不朽教教众选拔，表达加入意愿并回答考官提问。</data>
      <data key="d10">参加选拔,申请加入</data>
      <data key="d11">doc-7481ec7e871977b5736b57f15e207f14-chunk-009</data>
