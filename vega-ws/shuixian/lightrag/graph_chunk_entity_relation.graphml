    <node id="狂魔金身">
      <data key="d0">狂魔金身</data>
      <data key="d1">item</data>
      <data key="d2">林少游练成的金属性法术，属于禁忌法术，杀伤力极大。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474209</data>
