    <node id="长老们">
      <data key="d0">长老们</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-013</data>
      <data key="d2">长老们在议事大殿开会讨论灵石分配问题，因灵石不足而无法实施各种想法。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473548</data>
      <data key="d6" />
    </node>
    <node id="筑基中期">
      <data key="d0">筑基中期</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-013&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-017&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-033</data>
      <data key="d2">陆阳的目标是早日进入筑基中期，目前处于筑基初期。&lt;SEP&gt;白铭战斗前的修为境界，已停留数月。&lt;SEP&gt;修仙境界，陆阳感觉距离突破只差一个念头。</data>
      <data key="d1">concept</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474216</data>
      <data key="d6" />
    </node>
    <node id="兵俑">
      <data key="d0">兵俑</data>
      <data key="d1">item</data>
      <data key="d2">现代文明中替代活人作为陪葬品的陶俑。&lt;SEP&gt;以泥土和木头制作的士兵全身塑像，通常作为随葬品列队排在墓穴，遇到墓穴入口的兵俑需逃跑，兵俑可能活动起来。&lt;SEP&gt;以泥土制成的威武人俑，手持各式法器，分两排屹立在通道尽头，像是在守卫石碑。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-001&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="僵尸">
      <data key="d0">僵尸</data>
      <data key="d1">item</data>
      <data key="d2">盗墓经常遇到的怪物，种类分为紫僵、白僵、绿僵、毛僵、飞僵、游尸、伏尸、魃，对应不同修炼境界，天生阴物，最惧至刚至阳的真火。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="身份玉牌">
      <data key="d0">身份玉牌</data>
      <data key="d1">item</data>
      <data key="d2">陆阳随身携带的玉牌，从中拿出一根小木棍用于寻找出口。&lt;SEP&gt;陆阳随身携带的物品，用于存放《盗墓心得》等物品。&lt;SEP&gt;问道宗弟子的身份证明，陆阳用它向客栈老板证明身份。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-022&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="墓穴">
      <data key="d0">墓穴</data>
      <data key="d1">location</data>
      <data key="d2">陆阳所处的广阔墓穴空间，内有兵俑、僵尸等危险，灯光昏暗，有滴水声。&lt;SEP&gt;大长老在问道宗崖壁上建造的坟墓，为雏形，放置白毛僵尸维持气氛。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="紫僵">
      <data key="d0">紫僵</data>
      <data key="d1">item</data>
      <data key="d2">僵尸的一种，对应练气期，皮肤发紫，在墓穴中袭击陆阳。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="白僵">
      <data key="d0">白僵</data>
      <data key="d1">item</data>
      <data key="d2">僵尸的一种，对应筑基期，其中一只白毛僵尸拍陆阳肩膀。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="小木棍">
      <data key="d0">小木棍</data>
      <data key="d1">item</data>
      <data key="d2">陆阳从身份玉牌中拿出的小木棍，立在地上倒向东北方，用于寻找出口。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="布衣镇客栈">
      <data key="d0">布衣镇客栈</data>
      <data key="d1">location</data>
      <data key="d2">布衣镇中的客栈，设有地字号房和天字号房，有特定规则约束客人和店小二的行为。&lt;SEP&gt;布衣镇中的客栈，陆阳和孟景舟的暂住地，店小二和老板在此工作。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-023&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-022</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="布衣镇客栈规则">
      <data key="d0">布衣镇客栈规则</data>
      <data key="d1">concept</data>
      <data key="d2">客栈内需遵守的规则，包括在特定时间关闭房门可保证安全，以及尽可能满足客人要求但不违背伦理纲常。&lt;SEP&gt;客栈老板遵守的规则，规定在规则之内尽可能满足客人要求，但具体内容不能透露。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-023&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-022</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="地字四号房">
      <data key="d0">地字四号房</data>
      <data key="d1">location</data>
      <data key="d2">客栈内的房间，棕色门，由陆阳和孟景舟入住。&lt;SEP&gt;布衣镇客栈中的一间地字号房间，陆阳和孟景舟入住于此，是安全区域。&lt;SEP&gt;客栈中的房间，陆阳通过更换门牌将其变为安全区域，用于困住店小二。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-023&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-018&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="石门">
      <data key="d0">石门</data>
      <data key="d1">item</data>
      <data key="d2">洞府入口处的两扇石门，由大能炼制而成，陆阳无法撼动其分毫。&lt;SEP&gt;由大能炼制而成的门，关闭后洞府陷入黑暗，无法被筑基期修士撼动。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-000&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="落红霞">
      <data key="d0">落红霞</data>
      <data key="d1">character</data>
      <data key="d2">与不语道人一同下山历练的同伴，曾共同经历驱鬼和分尸案事件。&lt;SEP&gt;月桂仙宫宫主，向六长老打听陆阳的情况，疑似想介绍兰亭给陆阳。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-014&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-013&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-022</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473926</data>
      <data key="d6" />
    </node>
    <node id="飞车">
      <data key="d0">飞车</data>
      <data key="d1">item</data>
      <data key="d2">陆阳设计的飞行载具，形状如马车，由钢铁壳子、方向盘、窗户、座椅等组成，以飞剑为动力，可载多人飞行。&lt;SEP&gt;陆阳发明的全新飞行工具，以御剑飞行方式驱动，可悬浮高空，速度快，能进行锐角转弯，被五长老认为可能成为主流交通工具。&lt;SEP&gt;陆阳从身份玉牌中取出的造型奇异的飞行工具，可当作剑鞘使用。&lt;SEP&gt;陆阳发明的奇特飞行载具，外形似剑鞘，能承载五人，依靠飞剑术驱动，在西方某小镇上空失灵坠落。&lt;SEP&gt;陆阳委托李浩然炼制的物品，二人合力炼制三天完成。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-014&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-011&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-010&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-015&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-016</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474216</data>
      <data key="d6" />
    </node>
    <node id="布衣镇祖祠">
      <data key="d0">布衣镇祖祠</data>
      <data key="d1">location</data>
      <data key="d2">布衣镇中的祖祠，内部供奉一尊遮目半裸的佛像，佛像前有三碗清水，祖祠内无法损坏佛像且怪物无法在此吃人。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473696</data>
      <data key="d6" />
    </node>
    <node id="布衣镇祖祠规则">
      <data key="d0">布衣镇祖祠规则</data>
      <data key="d1">concept</data>
      <data key="d2">贴在祖祠门口的规则条文，目前仅展示第一条，涉及穿黑色或白色衣服时出现头晕等症状的情况。&lt;SEP&gt;贴在祖祠门口的规则，包含四条内容，涉及进入祖祠的条件、佛像无法损坏、祖祠有吃人怪物以及祖祠是安全的。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-031</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473696</data>
      <data key="d6" />
    </node>
    <node id="佛像">
      <data key="d0">佛像</data>
      <data key="d1">item</data>
      <data key="d2">祖祠中的半裸佛像，蒙住双眼，打碎后可打开离开小镇的出口。&lt;SEP&gt;祖祠中央供奉的遮目半裸佛像，妖艳而诡异，无法被损坏，孟景舟曾举起佛像对抗镇长。&lt;SEP&gt;祖祠内用巨石雕刻的佛像，无法损坏，被用作武器砸向镇长，破碎后会开启混沌通道。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-033&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-026</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473696</data>
      <data key="d6" />
    </node>
    <node id="清水">
      <data key="d0">清水</data>
      <data key="d1">item</data>
      <data key="d2">佛像前的三碗清水，据规则第一条所述，饮用后可解除黑狗化状态。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473696</data>
      <data key="d6" />
    </node>
    <node id="黑狗化">
      <data key="d0">黑狗化</data>
      <data key="d1">concept</data>
      <data key="d2">一种异常状态，表现为头晕、目眩或手臂长出黑色毛发，可通过饮用佛像前的清水解除。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473696</data>
      <data key="d6" />
    </node>
    <node id="衙役">
      <data key="d0">衙役</data>
      <data key="d1">character</data>
      <data key="d2">衙役是布衣镇中的官方执法人员和官府下属，身穿黑色衣服，腰间别刀，并随身携带【布衣镇衙役规则】以防忘记规则。他们遵守与外来者不同的规则，日常饮食受限，每天只能吃肉包子。在故事中，衙役因肉包子事件与陆阳和孟景舟结怨，多次追捕二人，但先后被两人三次戏耍，证明其并非二人的对手。陆阳曾计划从衙役入手以了解镇长的行动方式，而衙役本身也是镇长计划中的一部分。最终，衙役被引入私塾，与黑狗人发生冲突，并被关押待查。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-034&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-020&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-028&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-027&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-029&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-030&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473935</data>
      <data key="d6" />
    </node>
    <node id="原神">
      <data key="d0">原神</data>
      <data key="d1">item</data>
      <data key="d2">一款由中国游戏公司米哈游开发的开放世界动作角色扮演游戏，玩家在提瓦特大陆进行冒险。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="米哈游">
      <data key="d0">米哈游</data>
      <data key="d1">faction</data>
      <data key="d2">中国游戏开发公司，是游戏《原神》的开发商。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="提瓦特大陆">
      <data key="d0">提瓦特大陆</data>
      <data key="d1">location</data>
      <data key="d2">《原神》游戏中的虚构世界，是玩家冒险的主要舞台。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="旅行者">
      <data key="d0">旅行者</data>
      <data key="d1">character</data>
      <data key="d2">《原神》游戏中的主角，玩家扮演的角色，在提瓦特大陆旅行。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="派蒙">
      <data key="d0">派蒙</data>
      <data key="d1">character</data>
      <data key="d2">《原神》游戏中的主要伙伴角色，陪伴旅行者进行冒险。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="七国">
      <data key="d0">七国</data>
      <data key="d1">location</data>
      <data key="d2">提瓦特大陆中的七个主要国家，是游戏世界观的重要组成部分。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
      <data key="d6" />
    </node>
    <node id="元素">
      <data key="d0">元素</data>
      <data key="d1">concept</data>
      <data key="d2">《原神》游戏中的核心战斗机制，包括火、水、雷、风、冰、岩、草等元素。&lt;SEP&gt;构成世界的基本物质或能量形态，如火焰、水、风、土等。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474217</data>
      <data key="d6" />
    </node>
    <node id="神之眼">
      <data key="d0">神之眼</data>
      <data key="d1">item</data>
      <data key="d2">《原神》游戏中角色使用元素力量的关键道具，与角色的元素能力相关。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473698</data>
