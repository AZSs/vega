    <node id="光头陆阳分身">
      <data key="d0">光头陆阳分身</data>
      <data key="d1">item</data>
      <data key="d2">陆阳的分身，由不朽仙子控制，用于施展避水诀。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-017</data>
