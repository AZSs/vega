    <node id="上品灵石">
      <data key="d0">上品灵石</data>
      <data key="d1">item</data>
      <data key="d2">巴大爷带来的高品质灵石，用于让小药王埋回原处。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-029</data>
