    <node id="龙族博物馆">
      <data key="d0">龙族博物馆</data>
      <data key="d1">location</data>
      <data key="d2">收藏龙族相关物品的博物馆，云芝曾去过，馆内无野生化龙草。</data>
      <data key="d3">doc-8cd11b1c29c0a50ae046f374148d440b-chunk-015</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473921</data>
