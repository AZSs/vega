      <data key="d14" />
    </edge>
    <edge source="李浩然" target="飞车">
      <data key="d8">2.0</data>
      <data key="d9">李浩然在百炼峰炼制飞车挂件，经过三天努力完成。&lt;SEP&gt;李浩然受陆阳委托炼制飞车，二人合力完成。</data>
      <data key="d10">炼制</data>
      <data key="d11">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-010&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-016</data>
