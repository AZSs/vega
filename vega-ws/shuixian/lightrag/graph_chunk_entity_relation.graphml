    <node id="王教授">
      <data key="d0">王教授</data>
      <data key="d1">character</data>
      <data key="d2">一位教授，指导或参与李华的研究项目。&gt;</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-026</data>
      <data key="d4">unknown_source</data>
