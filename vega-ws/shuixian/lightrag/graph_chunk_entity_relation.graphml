    <node id="三十年灵酒女儿红">
      <data key="d0">三十年灵酒女儿红</data>
      <data key="d1">item</data>
      <data key="d2">迟绪龙和沈进义带来的灵酒，酒劲极强，连筑基期也无法化解。</data>
      <data key="d3">doc-7481ec7e871977b5736b57f15e207f14-chunk-029</data>
      <data key="d4">unknown_source</data>
