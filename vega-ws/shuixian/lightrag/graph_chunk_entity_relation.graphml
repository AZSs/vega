      <data key="d0">天启四骑士</data>
      <data key="d1">faction</data>
      <data key="d2">天启四骑士是天启的追随者，包括灵蝶、天使、暴风女和万磁王。&lt;SEP&gt;由天启招募的四位强大变种人组成的团体，作为天启的追随者和执行者。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-000&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-031</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473710</data>
      <data key="d6" />
    </node>
    <node id="变种人">
      <data key="d0">变种人</data>
      <data key="d1">concept</data>
      <data key="d2">变种人是拥有超常能力的特殊人类群体，是X战警系列的核心概念。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="X战警：天启">
      <data key="d0">X战警：天启</data>
      <data key="d1">item</data>
      <data key="d2">《X战警：天启》是一部超级英雄电影，讲述了X战警对抗天启的故事。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="回气丹">
      <data key="d0">回气丹</data>
      <data key="d1">item</data>
      <data key="d2">一种比回气散效果更好的药物，陆阳提到早知道就买回气丹。&lt;SEP&gt;执事们在维持大阵时服用的丹药，用于恢复气力。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013&lt;SEP&gt;doc-7481ec7e871977b5736b57f15e207f14-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473011</data>
      <data key="d6" />
    </node>
    <node id="凝水诀">
      <data key="d0">凝水诀</data>
      <data key="d1">item</data>
      <data key="d2">一种法术，陆阳运转后指尖出现水团，用于饮水。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="大小如意">
      <data key="d0">大小如意</data>
      <data key="d1">item</data>
      <data key="d2">一种法术，孟景舟族中叔叔曾施展，与“成寸”相似，门槛极高。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="虎皮">
      <data key="d0">虎皮</data>
      <data key="d1">item</data>
      <data key="d2">虎妖的皮毛，被兰亭收下，价值较高。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="虎骨">
      <data key="d0">虎骨</data>
      <data key="d1">item</data>
      <data key="d2">虎妖的骨头，陆阳询问孟景舟是否需要。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="虎鞭">
      <data key="d0">虎鞭</data>
      <data key="d1">item</data>
      <data key="d2">虎妖的鞭，陆阳询问孟景舟是否需要，并开玩笑说可壮阳。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="洞穴">
      <data key="d0">洞穴</data>
      <data key="d1">location</data>
      <data key="d2">虎妖的巢穴，三米高，内部漆黑，陆阳等人进入探索。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="云芝大师姐">
      <data key="d0">云芝大师姐</data>
      <data key="d1">character</data>
      <data key="d2">问道宗的大师姐，可能独创了法术“成寸”。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="避雨咒">
      <data key="d0">避雨咒</data>
      <data key="d1">item</data>
      <data key="d2">一种法术，陆阳等人使用后大雨对三人没有影响。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-013</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="灵厨">
      <data key="d0">灵厨</data>
      <data key="d1">concept</data>
      <data key="d2">一种冷门的修士类型，讲究五行相生，制作的食物既美味又能提升修为，在延江郡数量稀少。&lt;SEP&gt;修士中通过做饭修炼的职业，陆阳认为自己与其修炼方式有异曲同工之妙。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-027</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473498</data>
      <data key="d6" />
    </node>
    <node id="叶文洁">
      <data key="d0">叶文洁</data>
      <data key="d1">character</data>
      <data key="d2">叶文洁是《三体》系列中的重要人物，她向三体文明发送了地球的坐标，引发了后续的入侵。&gt;&lt;SEP&gt;叶文洁是《三体》系列中的关键人物，其行动导致了人类与三体文明的首次接触，是故事的重要推动者。&lt;SEP&gt;向三体文明发送地球坐标的科学家，引发危机。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-006&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473927</data>
      <data key="d6" />
    </node>
    <node id="地球">
      <data key="d0">地球</data>
      <data key="d1">location</data>
      <data key="d2">地球是人类文明的所在地，也是三体文明入侵的目标。&gt;&lt;SEP&gt;人类文明的居住星球，是三体文明入侵的目标。&lt;SEP&gt;地球是人类文明的居住地，是三体入侵的主要目标。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-018&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474215</data>
      <data key="d6" />
    </node>
    <node id="阶梯计划">
      <data key="d0">阶梯计划</data>
      <data key="d1">concept</data>
      <data key="d2">阶梯计划是人类向三体文明发送探测器以获取情报的计划，云天明是其中的关键人物。&gt;&lt;SEP&gt;向三体文明发送人类间谍的计划，云天明参与其中。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473927</data>
      <data key="d6" />
    </node>
    <node id="三体舰队">
      <data key="d0">三体舰队</data>
      <data key="d1">faction</data>
      <data key="d2">三体舰队是三体文明派往地球的入侵舰队，其到达地球的时间是威慑的关键因素。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="人类文明">
      <data key="d0">人类文明</data>
      <data key="d1">faction</data>
      <data key="d2">人类文明是地球上的文明总称，其生存与三体文明的入侵密切相关。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="面壁者">
      <data key="d0">面壁者</data>
      <data key="d1">concept</data>
      <data key="d2">面壁者是面壁计划中的执行者，负责制定和执行对抗三体入侵的秘密战略。&gt;&lt;SEP&gt;面壁计划中的执行者，拥有特殊权限。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473927</data>
      <data key="d6" />
    </node>
    <node id="破壁人">
      <data key="d0">破壁人</data>
      <data key="d1">concept</data>
      <data key="d2">破壁人是三体文明派出的间谍，负责识破面壁者的计划。&gt;&lt;SEP&gt;负责识破面壁者真实意图的三体文明代理人。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473927</data>
      <data key="d6" />
    </node>
    <node id="威慑博弈">
      <data key="d0">威慑博弈</data>
      <data key="d1">concept</data>
      <data key="d2">威慑博弈是地球与三体文明之间的战略博弈，核心在于威慑系统的有效性和执剑人的决策。&gt;&lt;SEP&gt;威慑博弈是地球与三体文明之间围绕威慑平衡展开的战略互动，涉及执剑人的决策与双方的心理较量。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473708</data>
      <data key="d6" />
    </node>
    <node id="三体入侵">
      <data key="d0">三体入侵</data>
      <data key="d1">concept</data>
      <data key="d2">三体入侵是三体文明对地球的军事行动，是《三体》系列的核心事件。&gt;&lt;SEP&gt;威慑失败后，三体文明对地球发动的大规模入侵。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034&lt;SEP&gt;doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474442</data>
      <data key="d6" />
    </node>
    <node id="罗辑的威慑">
      <data key="d0">罗辑的威慑</data>
      <data key="d1">concept</data>
      <data key="d2">罗辑的威慑是指罗辑作为执剑人时建立的威慑体系，成功维持了地球与三体文明之间的战略平衡。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="程心的决策">
      <data key="d0">程心的决策</data>
      <data key="d1">concept</data>
      <data key="d2">程心的决策是指程心接任执剑人后做出的关键选择，导致威慑失败。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="三体文明入侵地球">
      <data key="d0">三体文明入侵地球</data>
      <data key="d1">concept</data>
      <data key="d2">三体文明入侵地球是《三体》系列的核心事件，导致人类文明面临生存危机。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="威慑系统失效">
      <data key="d0">威慑系统失效</data>
      <data key="d1">concept</data>
      <data key="d2">威慑系统失效是指威慑系统无法继续维持战略平衡，导致三体文明发动入侵。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="罗辑与三体文明">
      <data key="d0">罗辑与三体文明</data>
      <data key="d1">concept</data>
      <data key="d2">罗辑与三体文明的关系是《三体》系列的核心冲突，罗辑通过威慑系统与三体文明对抗。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="程心与威慑系统">
      <data key="d0">程心与威慑系统</data>
      <data key="d1">concept</data>
      <data key="d2">程心与威慑系统的关系是《三体》系列的关键情节，程心的决策导致威慑系统失效。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="三体文明与地球文明">
      <data key="d0">三体文明与地球文明</data>
      <data key="d1">concept</data>
      <data key="d2">三体文明与地球文明的关系是《三体》系列的核心冲突，两者之间的战争决定了人类的命运。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="罗辑与面壁计划">
      <data key="d0">罗辑与面壁计划</data>
      <data key="d1">concept</data>
      <data key="d2">罗辑与面壁计划的关系是《三体》系列的关键情节，罗辑作为面壁者执行了对抗三体文明的计划。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="叶文洁与三体文明">
      <data key="d0">叶文洁与三体文明</data>
      <data key="d1">concept</data>
      <data key="d2">叶文洁与三体文明的关系是《三体》系列的开端，叶文洁向三体文明发送了地球的坐标。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="智子与地球文明">
      <data key="d0">智子与地球文明</data>
      <data key="d1">concept</data>
      <data key="d2">智子与地球文明的关系是《三体》系列的关键情节，智子被用于监视和干扰人类的科技发展。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="引力波广播与威慑系统">
      <data key="d0">引力波广播与威慑系统</data>
      <data key="d1">concept</data>
      <data key="d2">引力波广播与威慑系统的关系是《三体》系列的核心机制，引力波广播是威慑系统的核心功能。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="云天明与阶梯计划">
      <data key="d0">云天明与阶梯计划</data>
      <data key="d1">concept</data>
      <data key="d2">云天明与阶梯计划的关系是《三体》系列的关键情节，云天明是阶梯计划中的关键人物。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="三体舰队与地球">
      <data key="d0">三体舰队与地球</data>
      <data key="d1">concept</data>
      <data key="d2">三体舰队与地球的关系是《三体》系列的核心冲突，三体舰队是入侵地球的军事力量。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="威慑失败与三体入侵">
      <data key="d0">威慑失败与三体入侵</data>
      <data key="d1">concept</data>
      <data key="d2">威慑失败与三体入侵的关系是《三体》系列的关键情节，威慑失败导致三体文明发动入侵。&gt;</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="宇宙社会学与黑暗森林法则">
      <data key="d0">宇宙社会学与黑暗森林法则</data>
