    <node id="卧底排查会议">
      <data key="d0">卧底排查会议</data>
      <data key="d1">concept</data>
      <data key="d2">五大仙门领导者在问道宗山峰举行的秘密会议，讨论如何排查魔教卧底。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-013</data>
