    <node id="假死之术">
      <data key="d0">假死之术</data>
      <data key="d1">concept</data>
      <data key="d2">一种用于蒙混过关的术法，应天仙曾借此逃脱陪葬命运。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-003</data>
      <data key="d4">unknown_source</data>
