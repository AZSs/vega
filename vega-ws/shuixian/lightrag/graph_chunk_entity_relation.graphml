    <node id="三眛真火">
      <data key="d0">三眛真火</data>
      <data key="d1">item</data>
      <data key="d2">修仙界最著名的真火，炼丹至宝，能炼化天材地宝，陆阳在炼制飞车时提供此火。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-016</data>
