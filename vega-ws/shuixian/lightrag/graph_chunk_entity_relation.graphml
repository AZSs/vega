      <data key="d13">1785473542</data>
      <data key="d14" />
    </edge>
    <edge source="巴大爷" target="洞府封印">
      <data key="d8">1.0</data>
      <data key="d9">巴大爷尝试轰开洞府入口，攻击被雷霆化解，最终被封印吸入洞府。</data>
      <data key="d10">攻击,被吸</data>
      <data key="d11">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-028</data>
