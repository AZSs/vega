    <node id="成粉">
      <data key="d0">成粉</data>
      <data key="d1">item</data>
      <data key="d2">一种药物，经过十小时熬煮，喝下后会暂时发困，睡一觉后狗吠的影响消失。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-026</data>
      <data key="d4">unknown_source</data>
