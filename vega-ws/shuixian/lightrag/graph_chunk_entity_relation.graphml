    </node>
    <node id="狭间之地">
      <data key="d0">狭间之地</data>
      <data key="d1">location</data>
      <data key="d2">游戏的主要舞台，是一片被破碎法环影响的广阔土地。</data>
      <data key="d3">doc-902cfd82176fcda19b070b14d08def89-chunk-015</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
