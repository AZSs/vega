    <node id="学术讲座">
      <data key="d0">学术讲座</data>
      <data key="d1">concept</data>
      <data key="d2">学校定期举办的学术活动，邀请专家分享知识，学生可参与学习。&gt;</data>
      <data key="d3">doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-029</data>
