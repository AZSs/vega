      <data key="d2">陆阳的师父，本门掌门，准备了三位弟子的画像代替在场，接受陆阳拜师，据云芝所言仍然活着。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="师祖">
      <data key="d0">师祖</data>
      <data key="d1">character</data>
      <data key="d2">本门的师祖，在拜师仪式中被陆阳提及作为见证。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="本门">
      <data key="d0">本门</data>
      <data key="d1">faction</data>
      <data key="d2">陆阳和云芝所在的师门，满门忠烈，仅余下陆阳和云芝二人。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="信香">
      <data key="d0">信香</data>
      <data key="d1">item</data>
      <data key="d2">一种灵香，可将心中所想传递出去，用于给师父上香表达感激和尊敬之意。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="白骨丹">
      <data key="d0">白骨丹</data>
      <data key="d1">item</data>
      <data key="d2">一种丹药，有生死人肉白骨的功效。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="七级浮屠丹">
      <data key="d0">七级浮屠丹</data>
      <data key="d1">item</data>
      <data key="d2">佛国发明的丹药，救人一命胜造七级浮屠，服用者可使佛国获得一份功德。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="九转轮回丹">
      <data key="d0">九转轮回丹</data>
      <data key="d1">item</data>
      <data key="d2">修仙界的丹药，有九死轮回换一活的说法。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="水缸">
      <data key="d0">水缸</data>
      <data key="d1">item</data>
      <data key="d2">云芝从储物空间中取出的两只大水缸，用于炼体训练，重约二百斤，后被画符减轻重量。&lt;SEP&gt;陆阳炼体训练用的重要工具，每只重二百斤，被陆阳用来练习耍缸技艺，可单手拎起或踩踏行走。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="佛国">
      <data key="d0">佛国</data>
      <data key="d1">faction</data>
      <data key="d2">发明七级浮屠丹的势力，通过丹药积攒功德。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="炼体训练">
      <data key="d0">炼体训练</data>
      <data key="d1">concept</data>
      <data key="d2">修炼的基础训练，重点锻炼臂力，由云芝指导陆阳从零开始。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="威慑系统">
      <data key="d0">威慑系统</data>
      <data key="d1">item</data>
      <data key="d2">由罗辑建立的系统，能够向三体星系发送坐标，导致三体文明被其他文明毁灭，从而形成威慑。&lt;SEP&gt;由罗辑控制，用于威慑三体文明的系统，若失效则三体将入侵地球。&lt;SEP&gt;由罗辑控制的关键系统，用于威慑三体文明。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-034&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-015</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="乡正">
      <data key="d0">乡正</data>
      <data key="d1">character</data>
      <data key="d2">太平乡的乡正，练气后期修为，因早年基础未打好而无望筑基，负责接待陆阳和桃夭叶并告知妖鸟情况。&lt;SEP&gt;太平乡的乡正，练气七层修为，负责接待陆阳和桃夭叶，介绍妖鸟和张观甲的情况。&lt;SEP&gt;太平乡的地方官员，为人谨慎，对问道宗弟子恭敬，负责接待陆阳等人并协助调查妖鸟事件。&lt;SEP&gt;太平乡的地方官员，见识有限，协助陆阳调查鹦鹉来源，提供尚家的线索。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-034&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="冯裁缝">
      <data key="d0">冯裁缝</data>
      <data key="d1">character</data>
      <data key="d2">太平乡的裁缝，第一个发现妖鸟并报告给乡正，描述妖鸟会说话且花花绿绿。&lt;SEP&gt;曾喊出“妖怪”一词的人，鹦鹉模仿其话语导致张观甲被误认为妖怪。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="妖鸟">
      <data key="d0">妖鸟</data>
      <data key="d1">character</data>
      <data key="d2">出现在太平乡的妖怪，羽毛鲜艳、眼周有红色，会说话，询问张观甲的下落，不伤人但引起恐慌。&lt;SEP&gt;在太平乡四处飞行的妖兽，口吐人言，食田中粮食，寻找张观甲并喊“妖怪”，修为至少练气七层。&lt;SEP&gt;一只鹦鹉，来自茂密丛林深处，以无花果和浆果为食，善于模仿人言，在太平乡制造混乱，诬陷张观甲为妖怪。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-034</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="张观甲">
      <data key="d0">张观甲</data>
      <data key="d1">character</data>
      <data key="d2">太平乡的修士，练气三层修为，被妖鸟寻找，与妖兽产生联系的原因不明。&lt;SEP&gt;太平乡的修士，练气三层，开私塾教导儒学和修仙，被妖鸟寻找并喊“妖怪”，有两个弟弟张观乙和张观丙。&lt;SEP&gt;太平乡的普通人，年过四旬未婚，被妖鸟诬陷为妖怪，生活受到严重影响，向陆阳等人抱怨。&lt;SEP&gt;被鹦鹉误称为妖怪的当地居民，因陆阳的解释而洗清冤屈，对鹦鹉感到愤怒。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-034&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="妖鸟事件">
      <data key="d0">妖鸟事件</data>
      <data key="d1">concept</data>
      <data key="d2">太平乡发生的妖鸟出现事件，导致当地恐慌和商业受阻，引发问道宗弟子调查。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="李华">
      <data key="d0">李华</data>
      <data key="d1">character</data>
      <data key="d2">一位来自中国的大学生，正在学习英语，希望通过与外国朋友交流提高英语水平。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="王明">
      <data key="d0">王明</data>
      <data key="d1">character</data>
      <data key="d2">李华的中国同学，同样在学习英语，对英语学习有热情。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="英语学习">
      <data key="d0">英语学习</data>
      <data key="d1">concept</data>
      <data key="d2">李华和王明共同参与的学习活动，旨在提高英语听说读写能力。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="外国朋友">
      <data key="d0">外国朋友</data>
      <data key="d1">character</data>
      <data key="d2">李华通过语言交换平台结识的英语母语者，帮助李华练习英语。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="八位长老">
      <data key="d0">八位长老</data>
      <data key="d1">character</data>
      <data key="d2">问道宗中掌管八座山峰的长老，各有所长，山峰作用各不相同。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-011</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="双灵根弟子">
      <data key="d0">双灵根弟子</data>
      <data key="d1">character</data>
      <data key="d2">问道宗新弟子中拥有双灵根的人，陆阳都见过，排在最后登上第五十阶。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-011</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="小沙弥">
      <data key="d0">小沙弥</data>
      <data key="d1">character</data>
      <data key="d2">悬空庙弟子，尚未修行，但佛性深厚，被悬空庙师兄接走。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="上古蛮族血脉壮汉">
      <data key="d0">上古蛮族血脉壮汉</data>
      <data key="d1">character</data>
      <data key="d2">拥有上古蛮族血脉的壮汉，青铜肌肤，人高马大，年龄不到十六岁，参加问道宗考验。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="青木仙果">
      <data key="d0">青木仙果</data>
      <data key="d1">item</data>
      <data key="d2">一种仙果，服用后可使体内气息生生不绝，自行流转。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="单身灵根">
      <data key="d0">单身灵根</data>
      <data key="d1">concept</data>
      <data key="d2">孟景舟的灵根学名，俗名为纯阳灵根，变异单灵根，至刚至阳，鬼魅克星。&lt;SEP&gt;纯阳灵根的俗名，由第一位纯阳灵根前辈命名，修仙界有尊重单身老前辈的习惯。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="纯阳灵根">
      <data key="d0">纯阳灵根</data>
      <data key="d1">concept</data>
      <data key="d2">单身灵根的俗名，至刚至阳，保持纯阳之体修为一日千里，破掉纯阳之体修为受损。&lt;SEP&gt;一种变异单灵根，至刚至阳，是鬼魅克星，保持纯阳之体修为一日千里，破掉则修为一泻千里，俗名被称为单身灵根。&lt;SEP&gt;一种特殊的灵根资质，气血盈天，是鬼魅的克星，适合修行克制鬼魅的功法。&lt;SEP&gt;孟景舟拥有的灵根属性，因其身怀纯阳灵根，被认为不会有不正经的双修之术。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-012&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-005&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-027</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="陈平安">
      <data key="d0">陈平安</data>
      <data key="d1">character</data>
      <data key="d2">陈平安是故事中的主角，一位年轻的剑修，性格坚韧，追求武道极致，与多位人物有深厚关系。&lt;SEP&gt;一位年轻的剑修，性格坚韧，在修行路上不断成长，与多位人物有交集。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="宁姚">
      <data key="d0">宁姚</data>
      <data key="d1">character</data>
      <data key="d2">宁姚是陈平安的挚友或伴侣，性格独立，实力强大，与陈平安共同经历冒险。&lt;SEP&gt;一位女剑修，与陈平安关系密切，在修行道路上相互扶持。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="剑来">
      <data key="d0">剑来</data>
      <data key="d1">concept</data>
      <data key="d2">剑来是故事的核心概念，代表剑道修行与传承，贯穿整个叙事。&lt;SEP&gt;一部网络小说，讲述了陈平安的修行历程和江湖恩怨。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="剑气长城">
      <data key="d0">剑气长城</data>
      <data key="d1">location</data>
      <data key="d2">剑气长城是故事中的重要地点，象征剑修世界的边界与守护之地。&lt;SEP&gt;一个重要的修行地点，与陈平安的修行经历相关。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="阿良">
      <data key="d0">阿良</data>
      <data key="d1">character</data>
      <data key="d2">阿良是陈平安的师父或前辈，传授剑道，对陈平安的成长有重要影响。&lt;SEP&gt;一位剑修，与陈平安有师徒或指导关系。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="齐静春">
      <data key="d0">齐静春</data>
      <data key="d1">character</data>
      <data key="d2">齐静春是陈平安的对手或盟友，性格复杂，与陈平安有多次交锋与合作。&lt;SEP&gt;一位修行者，与陈平安有交集，可能提供帮助或指导。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="剑道">
      <data key="d0">剑道</data>
      <data key="d1">concept</data>
      <data key="d2">剑道是故事中的修行体系，强调剑术与心性的结合，是主要角色的追求目标。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="大补丹">
      <data key="d0">大补丹</data>
      <data key="d1">item</data>
      <data key="d2">傀儡在陆阳训练过程中喂食的丹药，用于恢复体力和缓解酸痛，帮助陆阳持续进行高强度训练。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="淬体药剂">
      <data key="d0">淬体药剂</data>
      <data key="d1">item</data>
      <data key="d2">云芝熬制的药浴材料，用于陆阳浸泡全身以强化体质，浸泡时需用芦苇管呼吸。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="芦苇管">
      <data key="d0">芦苇管</data>
      <data key="d1">item</data>
      <data key="d2">云芝提供给陆阳的空心管，用于在浸泡淬体药剂时呼吸，使陆阳能全身浸入药液中。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="烫伤药">
      <data key="d0">烫伤药</data>
      <data key="d1">item</data>
      <data key="d2">云芝在发现药浴水温过高后放置在门口的药品，用于治疗陆阳被烫伤的皮肤。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="仙家洞天">
      <data key="d0">仙家洞天</data>
      <data key="d1">location</data>
      <data key="d2">云芝成长的地方，接触的人都是修行者，使她对凡人常识了解较少。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
