    <node id="礼教">
      <data key="d0">礼教</data>
      <data key="d1">concept</data>
      <data key="d2">束缚人物情感与行为的传统道德规范。&gt;&lt;SEP&gt;封建社会的道德规范，束缚着人物的情感与行为。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-005&lt;SEP&gt;doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-020</data>
