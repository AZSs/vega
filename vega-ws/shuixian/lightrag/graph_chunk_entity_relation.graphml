    <node id="开天斧">
      <data key="d0">开天斧</data>
      <data key="d1">item</data>
      <data key="d2">仙器，在幻境中由仙人孟景舟取得。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-007</data>
