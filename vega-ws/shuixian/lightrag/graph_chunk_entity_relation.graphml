    </node>
    <node id="双修功法">
      <data key="d0">双修功法</data>
      <data key="d1">concept</data>
      <data key="d2">一种功法，分为正经和不正经两种，正经的用于男女互助、阴阳调和。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-026</data>
