    <node id="密斯卡托尼克大学">
      <data key="d0">密斯卡托尼克大学</data>
      <data key="d1">location</data>
      <data key="d2">密斯卡托尼克大学是克苏鲁神话中虚构的大学，位于阿卡姆，是研究禁忌知识的重要机构。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="死灵之书">
      <data key="d0">死灵之书</data>
      <data key="d1">item</data>
      <data key="d2">死灵之书是克苏鲁神话中虚构的禁忌魔法书，记载着关于旧神和宇宙的秘密知识。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="阿撒托斯">
      <data key="d0">阿撒托斯</data>
      <data key="d1">character</data>
      <data key="d2">阿撒托斯是克苏鲁神话中的盲目痴愚之神，被视为宇宙的终极混乱之源。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="犹格·索托斯">
      <data key="d0">犹格·索托斯</data>
      <data key="d1">character</data>
      <data key="d2">犹格·索托斯是克苏鲁神话中的外神之一，代表时间和空间的维度，拥有无尽的智慧。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
