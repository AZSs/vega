    <node id="偃师宗">
      <data key="d0">偃师宗</data>
      <data key="d1">faction</data>
      <data key="d2">一品门派中全部由傀儡师组成的宗门。</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-025</data>
