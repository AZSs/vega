    <edge source="三体文明" target="威慑系统">
      <data key="d7">2.0</data>
      <data key="d8">威慑系统用于威慑三体文明，防止其入侵地球。</data>
      <data key="d9">威慑</data>
      <data key="d10">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-020&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-034</data>
