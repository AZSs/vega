    <node id="小镇">
      <data key="d0">小镇</data>
      <data key="d1">location</data>
      <data key="d2">由合体期大修布置的封闭区域，设有规则和阵法，有生门和死门，难以离开。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-026</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473710</data>
      <data key="d6" />
    </node>
    <node id="通明草">
      <data key="d0">通明草</data>
      <data key="d1">item</data>
      <data key="d2">一种草药，揉碎后堵住耳朵可消除狗吠的影响。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-026</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473710</data>
