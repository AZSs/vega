      <data key="d0">金色纸张</data>
      <data key="d1">item</data>
      <data key="d2">记载缩地成寸心法口诀的金色纸张，由云芝取出交给陆阳。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-015</data>
