    <node id="金灵根">
      <data key="d0">金灵根</data>
      <data key="d1">concept</data>
      <data key="d2">杜学艺身具的灵根，使其身体坚如钢铁。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-009</data>
