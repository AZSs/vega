    <node id="黄牌">
      <data key="d0">黄牌</data>
      <data key="d1">item</data>
      <data key="d2">裁判用来警告孟景舟的处罚工具，被孟景舟误解为换取灵石的手段。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474216</data>
      <data key="d6" />
    </node>
    <node id="红牌">
      <data key="d0">红牌</data>
      <data key="d1">item</data>
      <data key="d2">裁判用来处罚自己的工具，因对选手出手而给自己红牌罚下。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-010</data>
