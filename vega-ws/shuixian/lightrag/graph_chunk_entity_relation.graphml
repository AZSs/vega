    <node id="六长老陆阳">
      <data key="d0">六长老陆阳</data>
      <data key="d1">character</data>
      <data key="d2">问道宗六长老，拥有与桃夭叶类似的仙体，美貌惊人。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-019</data>
      <data key="d4">unknown_source</data>
