    <node id="极品灵石">
      <data key="d0">极品灵石</data>
      <data key="d1">item</data>
      <data key="d2">孟景舟用来贿赂裁判和对手的高价值灵石。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474216</data>
      <data key="d6" />
