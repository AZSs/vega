    <node id="白色巨蛇">
      <data key="d0">白色巨蛇</data>
      <data key="d1">character</data>
      <data key="d2">缠绕山岳的巨蛇，吞吐日月炼化天地精华，陆阳和云芝曾落入其腹中。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-017</data>
