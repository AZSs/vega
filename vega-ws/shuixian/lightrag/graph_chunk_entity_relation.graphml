    <edge source="张观甲" target="私塾">
      <data key="d8">1.0</data>
      <data key="d9">张观甲开设私塾，教导孩子们儒学和修仙。</data>
      <data key="d10">开设经营</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033</data>
