    <node id="犹格斯星">
      <data key="d0">犹格斯星</data>
      <data key="d1">location</data>
      <data key="d2">犹格斯星是克苏鲁神话中虚构的冥王星，是米·戈的故乡。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
