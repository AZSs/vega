      <data key="d0">凡人</data>
      <data key="d1">concept</data>
      <data key="d2">普通人群，逆寿元符对其有效，会吸收寿元。</data>
      <data key="d3">doc-dcc4b221c37bbee6881460ac6550c181-chunk-008</data>
