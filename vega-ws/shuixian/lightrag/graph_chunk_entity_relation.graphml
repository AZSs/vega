      <data key="d14" />
    </edge>
    <edge source="妖族" target="桃夭叶">
      <data key="d8">1.0</data>
      <data key="d9">桃夭叶对妖族有较深了解，提出张观甲可能是化形大妖的猜测。</data>
      <data key="d10">了解认知</data>
