      <data key="d14" />
    </edge>
    <edge source="陆阳" target="土遁术">
      <data key="d8">2.0</data>
      <data key="d9">陆阳施展缩地成寸时意外学会土遁术，缩进土里。&lt;SEP&gt;陆阳施展缩地时意外缩进土里，从而学会了土遁术。</data>
      <data key="d10">学会,掌握,误施</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-016&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-017</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472609</data>
      <data key="d14" />
    </edge>
    <edge source="陆阳" target="成寸">
      <data key="d8">7.0</data>
      <data key="d9">陆阳意外学会成寸法术，施展后自身变小到三寸高。&lt;SEP&gt;陆阳使用成寸法术缩小到与人参娃娃相同的身高。&lt;SEP&gt;陆阳动用法术“成寸”缩小身形，躲避虎妖扑击。&lt;SEP&gt;陆阳施展法术“成寸”使身体变小变大。&lt;SEP&gt;陆阳在危急时刻使用成寸法术缩小身体，抓住衣服形成降落伞以减缓下落速度。&lt;SEP&gt;陆阳掌握成寸法术，并在战斗中结合其他法术使用。&lt;SEP&gt;陆阳在战斗中使用成寸法术。</data>
      <data key="d10">使用,学会,掌握,施展</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-017&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-020&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-012&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-013&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-000&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-034&lt;SEP&gt;doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-033</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785474265</data>
      <data key="d14" />
    </edge>
