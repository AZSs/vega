    <node id="睡莲">
      <data key="d0">睡莲</data>
      <data key="d1">item</data>
      <data key="d2">莫奈晚年创作的系列画作，描绘其吉维尼花园中的睡莲池，是印象派艺术的代表作。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-000</data>
      <data key="d4">unknown_source</data>
