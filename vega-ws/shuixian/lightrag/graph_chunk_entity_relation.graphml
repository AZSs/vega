    </node>
    <node id="印象派">
      <data key="d0">印象派</data>
      <data key="d1">concept</data>
      <data key="d2">19世纪法国艺术运动，强调对光线和瞬间印象的捕捉，注重户外写生和色彩表现。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
