    <node id="儒修师兄">
      <data key="d0">儒修师兄</data>
      <data key="d1">character</data>
      <data key="d2">问道宗金丹期弟子，天生儒修，大能赐福，口含天宪，手持至宝竹书，从容不迫。</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-032</data>
