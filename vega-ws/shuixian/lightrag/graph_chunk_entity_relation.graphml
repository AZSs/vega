    </node>
    <node id="大妖">
      <data key="d0">大妖</data>
      <data key="d1">concept</data>
      <data key="d2">上古时代横行蛮荒之地的强大妖兽，依靠血脉、体魄和天赋神通，被人族视为天灾般的存在。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-029</data>
      <data key="d4">unknown_source</data>
