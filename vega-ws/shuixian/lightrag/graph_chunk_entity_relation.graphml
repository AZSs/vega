      <data key="d6" />
    </node>
    <node id="杨玄龄">
      <data key="d0">杨玄龄</data>
      <data key="d1">character</data>
      <data key="d2">鉴定大师，在落地金钱商会的拍卖会坐镇，负责鉴定法术等物品的价值。&lt;SEP&gt;鉴定大师，坐镇拍卖会，负责鉴定陆阳的变形术，最终认可其为拍卖品。</data>
      <data key="d3">doc-dcc4b221c37bbee6881460ac6550c181-chunk-023&lt;SEP&gt;doc-dcc4b221c37bbee6881460ac6550c181-chunk-024</data>
