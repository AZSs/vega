    <node id="精神世界">
      <data key="d0">精神世界</data>
      <data key="d1">location</data>
      <data key="d2">陆阳体内的精神空间，云芝与不朽仙子在此对峙，陆阳被丢出后又返回。</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-007</data>
