    <node id="反盗墓笔记">
      <data key="d0">反盗墓笔记</data>
      <data key="d1">item</data>
      <data key="d2">墓穴中的一本书，讲述如何合理布置墓穴以防盗墓贼，并针对常见盗墓手段做出应对。</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-004</data>
