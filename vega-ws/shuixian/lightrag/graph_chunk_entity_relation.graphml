    <node id="帝城孟家">
      <data key="d0">帝城孟家</data>
      <data key="d1">faction</data>
      <data key="d2">大夏王朝的建立家族之一，与夏帝先祖一同打拼天下，孟景舟的家族，在中央大陆极有名望。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="夏帝先祖">
      <data key="d0">夏帝先祖</data>
      <data key="d1">character</data>
      <data key="d2">十万年前与孟家先祖一同揭竿而起、征战天下，建立大夏王朝的英雄人物。&lt;SEP&gt;十万年前乱世中崛起的另一位霸主，与孟家先祖征战天下，在星空决战中获胜，建立大夏王朝，并承诺只要大夏存在，孟家便不会消亡。&lt;SEP&gt;有识之士，振臂高呼“王侯将相，宁有种乎？”，成为千古名句，反对王公贵族的腐朽统治。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-010&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473504</data>
      <data key="d6" />
    </node>
    <node id="孟家先祖">
      <data key="d0">孟家先祖</data>
      <data key="d1">character</data>
      <data key="d2">十万年前与夏帝先祖一同打拼天下，建立大夏王朝的英雄人物。&lt;SEP&gt;十万年前乱世中崛起的一方霸主，与夏帝先祖一同征战天下，最终在星空决战中落败，拱手让位，其家族孟家因此获得大夏王朝的庇护。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="清蒸雷劫液">
      <data key="d0">清蒸雷劫液</data>
      <data key="d1">item</data>
      <data key="d2">酒楼菜品，修士渡劫时留下的雷劫精华，对感悟雷电之道有益。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="红烧冰渊巨象">
      <data key="d0">红烧冰渊巨象</data>
      <data key="d1">item</data>
      <data key="d2">酒楼菜品，食材为冰渊巨象，生活在极北之地的霸主种群。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="冰渊巨象">
      <data key="d0">冰渊巨象</data>
      <data key="d1">item</data>
      <data key="d2">生活在极北之地的霸主种群，成年个体可踏碎冰川、直面雪崩。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="西红柿炒蛋">
      <data key="d0">西红柿炒蛋</data>
      <data key="d1">item</data>
      <data key="d2">酒楼菜品，可选普通鸡蛋、八珍鸡鸡蛋、金翅大鹏蛋等多种蛋类。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="银环天王蚓夫妇">
      <data key="d0">银环天王蚓夫妇</data>
      <data key="d1">character</data>
      <data key="d2">药园中负责松土的蚯蚓夫妇，因家庭内战无心工作，导致松土任务无人执行。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="银环天王蚓妻子">
      <data key="d0">银环天王蚓妻子</data>
      <data key="d1">character</data>
      <data key="d2">银环天王蚓的妻子，被巴大爷说服将自己一分为二，变成两个一模一样的人，引发家庭矛盾。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="银环天王蚓丈夫">
      <data key="d0">银环天王蚓丈夫</data>
      <data key="d1">character</data>
      <data key="d2">银环天王蚓的丈夫，面对两个妻子直言喜欢姐妹花，导致家庭内战爆发。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="司律峰">
      <data key="d0">司律峰</data>
      <data key="d1">location</data>
      <data key="d2">问道宗大长老主管的山峰，公正严明，负责追究偷摘草药等违规行为的责任。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="土遁道法">
      <data key="d0">土遁道法</data>
      <data key="d1">concept</data>
      <data key="d2">五行道法之一，用于钻入土中松土，会此道法的弟子不少但嫌麻烦不愿接任务。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="神秘洞穴">
      <data key="d0">神秘洞穴</data>
      <data key="d1">location</data>
      <data key="d2">神秘洞穴位于偏远山区，内部结构复杂，充满未知的危险和可能的宝藏，是李四此次探险的目标地点。&gt;</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="古老地图">
      <data key="d0">古老地图</data>
      <data key="d1">item</data>
      <data key="d2">古老地图是一张描绘神秘洞穴内部路径的旧地图，由李四获得，上面标注了多个关键地点和潜在的危险区域。&gt;&lt;SEP&gt;古老地图是一张描绘神秘古墓位置和内部结构的古代地图，是探险的关键线索。&gt;</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473921</data>
      <data key="d6" />
    </node>
    <node id="洞穴守护者">
      <data key="d0">洞穴守护者</data>
      <data key="d1">character</data>
      <data key="d2">洞穴守护者是神秘洞穴深处的神秘生物，负责守护洞穴内的秘密和宝藏，对入侵者具有攻击性。&gt;</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-019</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="尚种田">
      <data key="d0">尚种田</data>
      <data key="d1">character</data>
      <data key="d2">尚家家主，盗墓者，曾因盗挖元婴期坟墓被墓主后人擒获，境界从练气巅峰跌至练气中期，入狱十年后金盆洗手。&lt;SEP&gt;尚家的退休盗墓者，曾因盗墓被官府抓捕入狱十年，出狱后金盆洗手，亲自安葬章管家的尸身，并赠送盗墓心得给陆阳和桃夭叶。&lt;SEP&gt;盗墓界臭名昭著的盗墓贼，其著作《盗墓心得》介绍了僵尸种类、棺材规格、墓室规格和常见机关等盗墓知识。&lt;SEP&gt;尚家家主，盗墓界臭名昭著的盗墓贼，曾将《盗墓心得》作为谢礼赠予陆阳。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="练气修士">
      <data key="d0">练气修士</data>
      <data key="d1">concept</data>
      <data key="d2">修仙境界中的低阶修士，贫穷，陪葬品少。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="筑基期修士">
      <data key="d0">筑基期修士</data>
      <data key="d1">concept</data>
      <data key="d2">修仙境界中的中阶修士，小有家产，死后留下部分陪葬品。&lt;SEP&gt;修士等级，秦元浩和陆阳等属于此级别，眼力有限无法直接看到纸上文字。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-029</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472812</data>
      <data key="d6" />
    </node>
    <node id="元婴期修士">
      <data key="d0">元婴期修士</data>
      <data key="d1">concept</data>
      <data key="d2">修仙境界中的高阶修士，其坟墓规格宏大，死后仍散发恐怖波动。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="元婴期坟墓">
      <data key="d0">元婴期坟墓</data>
      <data key="d1">location</data>
      <data key="d2">尚种田盗挖的主墓，规格宏大，陪葬品以八卦阵陈列，内有古尸和兵俑。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="金丹期坟墓">
      <data key="d0">金丹期坟墓</data>
      <data key="d1">location</data>
      <data key="d2">尚种田最初挖掘的坟墓，实为元婴期坟墓的陪葬部分。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="元婴期后人">
      <data key="d0">元婴期后人</data>
      <data key="d1">character</data>
      <data key="d2">元婴期修士的后代，前来祭拜祖先时发现尚种田盗墓并将其擒获。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-005</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="金钱商会">
      <data key="d0">金钱商会</data>
      <data key="d1">faction</data>
      <data key="d2">一个商会组织，与贡献点兑换灵石有关，陆阳认为其研究因果关系会招致商会不满。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="下品灵石">
      <data key="d0">下品灵石</data>
      <data key="d1">item</data>
      <data key="d2">修仙界通用货币，一个贡献点可兑换一百下品灵石。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="饮血飞剑">
      <data key="d0">饮血飞剑</data>
      <data key="d1">item</data>
      <data key="d2">兑换榜单上的物品，需两千贡献点，浸泡在血液时间越长威力越大。&lt;SEP&gt;一种飞剑，浸泡在血液中时间越长威力越大，需两千贡献点兑换，可用猪血、牛血、鸭血等浸泡。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="祖传烧烤秘方">
      <data key="d0">祖传烧烤秘方</data>
      <data key="d1">item</data>
      <data key="d2">一种烧烤配方，需一百贡献点兑换。&lt;SEP&gt;蛮骨挂在兑换榜单上的秘方，需一百贡献点兑换，原版材料多为荒野独有，蛮骨需研究替换方案。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-024</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="宝剑悬浮阵法">
      <data key="d0">宝剑悬浮阵法</data>
      <data key="d1">item</data>
      <data key="d2">一种可镌刻在武器上的阵法，使宝剑悬浮于后背，附带保护阵法，需二十五个贡献点，陆阳购买使用。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="十牛之力丹">
      <data key="d0">十牛之力丹</data>
      <data key="d1">item</data>
      <data key="d2">炼丹大师吴明炼制的丹药，服用后可获得十牛之力，横扫千军，筑基期到元婴期皆可用，价格分一百、一千、一万贡献点三档，陆阳购买一粒。&lt;SEP&gt;吴明研制的一种丹药，服用后通过微型召唤阵召唤十头水牛助人杀敌，筑基级售价一百贡献点。&lt;SEP&gt;丹鼎峰炼制的丹药，内附召唤阵，服用后召唤出十头筑基期水牛，而非增强自身力量。&lt;SEP&gt;吴明师兄炼制的丹药，陆阳认为其没有虚假宣传问题。&lt;SEP&gt;一种丹药，对陆阳帮助很大，购买时陆阳曾向桃夭叶借五个贡献点。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-011&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-010&lt;SEP&gt;doc-dcc4b221c37bbee6881460ac6550c181-chunk-020&lt;SEP&gt;doc-8cd11b1c29c0a50ae046f374148d440b-chunk-017</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473927</data>
      <data key="d6" />
      <data key="d7">十牛之力丹</data>
    </node>
    <node id="川蜀火锅">
      <data key="d0">川蜀火锅</data>
      <data key="d1">location</data>
      <data key="d2">问道宗内的火锅店家，曾投诉有人将饮血飞剑泡在鸭血中。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="老宗主">
      <data key="d0">老宗主</data>
      <data key="d1">character</data>
      <data key="d2">问道宗前任宗主，与前任长老们退休后，由现任宗主及八位长老上位。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="宗主及八位长老">
      <data key="d0">宗主及八位长老</data>
      <data key="d1">faction</data>
      <data key="d2">问道宗现任领导层，上位后鼓励弟子劳逸结合，发展娱乐产业。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="黄蓉">
      <data key="d0">黄蓉</data>
      <data key="d1">character</data>
      <data key="d2">黄蓉是《射雕英雄传》中的女主角，聪明机智，擅长易容术和机关术，是郭靖的妻子。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="郭靖">
      <data key="d0">郭靖</data>
      <data key="d1">character</data>
      <data key="d2">郭靖是《射雕英雄传》中的男主角，性格忠厚老实，武功高强，是黄蓉的丈夫。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="桃花岛">
      <data key="d0">桃花岛</data>
      <data key="d1">location</data>
      <data key="d2">桃花岛是黄蓉的家乡，位于东海，是黄药师居住的地方。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="黄药师">
      <data key="d0">黄药师</data>
      <data key="d1">character</data>
      <data key="d2">黄药师是桃花岛岛主，黄蓉的父亲，武功高强，精通琴棋书画和奇门遁甲。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="降龙十八掌">
      <data key="d0">降龙十八掌</data>
      <data key="d1">item</data>
      <data key="d2">降龙十八掌是郭靖的武功之一，威力强大，是丐帮的镇帮之宝。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="画皮鬼">
      <data key="d0">画皮鬼</data>
      <data key="d1">character</data>
      <data key="d2">一种鬼修，生前是人，死后为鬼，喜欢收集人皮伪装成人类混居，忌讳被人说破身份。&lt;SEP&gt;一种精怪，本体是一张皮，能脱皮换形，毒药对其无效，但会感染脚气。&lt;SEP&gt;生前是人，死后是鬼，是鬼修的一种，擅长收集人皮伪装成人类，沿袭伪装的习惯与人类混居，最忌讳被人说破身份，会努力让自己相信是人，待到厌倦后再换一张皮开启新的身份。&lt;SEP&gt;一种需要费一番功夫才能对付的鬼物，可能具有逃走的能力。&lt;SEP&gt;太平乡作祟的鬼物，伪装成鹦鹉引诱他人，被陆阳用毒制服并化为灰烬。&lt;SEP&gt;一种擅长诡异手段的鬼怪，不擅长正面攻击，与虎妖不同，其身份一旦被破解便容易战胜。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-004&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-002&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-003&lt;SEP&gt;doc-902cfd82176fcda19b070b14d08def89-chunk-008</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472814</data>
      <data key="d6" />
    </node>
    <node id="狐妖">
      <data key="d0">狐妖</data>
      <data key="d1">character</data>
      <data key="d2">要求孟景舟提供双修功法并验货的妖兽，投诉孟景舟态度有问题。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="发布任务的师兄">
      <data key="d0">发布任务的师兄</data>
      <data key="d1">character</data>
      <data key="d2">问道宗弟子，负责发布任务和评估完成情况，对陆阳和桃夭叶的表现刮目相看。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="盗墓心得">
      <data key="d0">盗墓心得</data>
      <data key="d1">item</data>
      <data key="d2">尚种田撰写的蓝色线状书籍，记录盗墓经验，赠送给陆阳和桃夭叶。&lt;SEP&gt;一本经过炼制的书籍，能发光鉴定陪葬品并显示刑期，功能离谱但带有合理性，由尚家家主赠予陆阳。&lt;SEP&gt;关于坟墓和盗墓的书籍，由尚种田所赠，第一页记载《大夏刑律》相关内容，第二页为目录，介绍僵尸种类、棺材规格、墓室规格和常见机关等。&lt;SEP&gt;尚种田所著的盗墓书籍，介绍了僵尸种类、棺材规格、墓室规格、常见机关等盗墓知识。&lt;SEP&gt;陆阳所学习的盗墓知识书籍，其中包含盗墓技巧和警告，如“越违背常理，越危险”。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-002&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-004&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-001&lt;SEP&gt;doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473690</data>
      <data key="d6" />
    </node>
    <node id="纯阳之身">
      <data key="d0">纯阳之身</data>
      <data key="d1">concept</data>
      <data key="d2">孟景舟的特殊体质，不能破身，影响其与狐妖的互动。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="尚家主">
      <data key="d0">尚家主</data>
      <data key="d1">character</data>
      <data key="d2">尚家家主，本名尚种田，曾为练气期盗墓者，因盗墓时遇到生死危机的大恐怖而金盆洗手，归隐乡下，为报答救命之恩愿变卖家产。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="白色瓷罐">
      <data key="d0">白色瓷罐</data>
      <data key="d1">item</data>
      <data key="d2">两掌高的白色瓷罐，用于装画皮鬼的灰烬，作为完成任务的凭证。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="鬼修">
      <data key="d0">鬼修</data>
      <data key="d1">concept</data>
      <data key="d2">死后为鬼的修行者，大多有某种心理障碍，画皮鬼是其中一种。&lt;SEP&gt;一种修炼方式，画皮鬼是鬼修的一种，各类鬼修大多都有某种心理障碍。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-004&lt;SEP&gt;doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="盗墓">
      <data key="d0">盗墓</data>
      <data key="d1">concept</data>
      <data key="d2">尚种田曾经的职业活动，在练气期盗墓界小有名气，因遇到生死危机而退出。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-004</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="问道宗宗主一日体验游">
      <data key="d0">问道宗宗主一日体验游</data>
      <data key="d1">item</data>
      <data key="d2">问道宗任务大殿的兑换奖励，可让兑换者当一天宗主，与长老开会、处理宗门事务，但所需贡献点过高，无人能兑换。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="飞舟意外险">
      <data key="d0">飞舟意外险</data>
      <data key="d1">item</data>
      <data key="d2">只需一个贡献点即可购买的保险，用于增加飞舟意外时的赔偿金额，问道宗在弟子入宗时已为其购买。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="保险">
      <data key="d0">保险</data>
      <data key="d1">concept</data>
      <data key="d2">由落地金钱商会会长提出的风险保障模式，乘客出少量钱放入池子，飞舟出现意外时商会从池子中拿出大笔钱赔偿乘客。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="克苏鲁">
      <data key="d0">克苏鲁</data>
      <data key="d1">character</data>
      <data key="d2">克苏鲁是克苏鲁神话体系中的主要神祇，被描述为沉睡在海底城市拉莱耶中的古老存在，其形象和影响力贯穿整个神话体系。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="拉莱耶">
      <data key="d0">拉莱耶</data>
      <data key="d1">location</data>
      <data key="d2">拉莱耶是克苏鲁沉睡的海底城市，位于南太平洋深处，是克苏鲁神话中的重要地点。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="克苏鲁神话">
      <data key="d0">克苏鲁神话</data>
      <data key="d1">concept</data>
      <data key="d2">克苏鲁神话是由美国作家霍华德·菲利普·洛夫克拉夫特开创的虚构神话体系，包含众多神祇、生物和禁忌知识。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="霍华德·菲利普·洛夫克拉夫特">
      <data key="d0">霍华德·菲利普·洛夫克拉夫特</data>
      <data key="d1">character</data>
      <data key="d2">霍华德·菲利普·洛夫克拉夫特是美国作家，克苏鲁神话体系的创始人和主要作者。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="旧日支配者">
      <data key="d0">旧日支配者</data>
      <data key="d1">concept</data>
      <data key="d2">旧日支配者是克苏鲁神话中的一类强大神祇，克苏鲁被视为其中的代表之一。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
      <data key="d6" />
    </node>
    <node id="阿卡姆">
      <data key="d0">阿卡姆</data>
      <data key="d1">location</data>
      <data key="d2">阿卡姆是克苏鲁神话中虚构的美国马萨诸塞州城镇，常作为故事发生地出现。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-007</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472591</data>
