    <node id="顶级炼体术">
      <data key="d0">顶级炼体术</data>
      <data key="d1">item</data>
      <data key="d2">不语道人曾赠予月桂仙宫的修炼法，练成后钢筋铁骨，皮肤坚硬如铁水浇灌。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-003</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474208</data>
      <data key="d6" />
    </node>
    <node id="高副宗主">
      <data key="d0">高副宗主</data>
      <data key="d1">character</data>
      <data key="d2">阶下囚，不朽教副宗主，嘲笑大长老无法使用黄粱枕，后被大长老用枕头敲击头部而入睡。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-030</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474208</data>
      <data key="d6" />
    </node>
    <node id="不朽教高层">
      <data key="d0">不朽教高层</data>
      <data key="d1">faction</data>
      <data key="d2">不朽教的五名高层成员，不时发出阴阳怪气的笑声，其中一人被大长老用黄粱枕敲击后入睡。&lt;SEP&gt;不朽教的高级成员，对年轻一代的合体打法感到困惑。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-030&lt;SEP&gt;doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-023</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474419</data>
      <data key="d6" />
    </node>
    <node id="上古之言">
      <data key="d0">上古之言</data>
      <data key="d1">concept</data>
      <data key="d2">一段由云芝传授给大长老的上古语言，吟唱时能提高黄粱枕的威力，含义不明。&lt;SEP&gt;上古时代的语言，与现代语言差距大，是施展预知未来法术时所使用的语言。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-030&lt;SEP&gt;doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474419</data>
      <data key="d6" />
    </node>
    <node id="灾厄">
      <data key="d0">灾厄</data>
      <data key="d1">concept</data>
      <data key="d2">盖侬带来的毁灭性力量，威胁海拉鲁王国的存续。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-030</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474209</data>
      <data key="d6" />
    </node>
    <node id="问道宗大长老">
      <data key="d0">问道宗大长老</data>
      <data key="d1">character</data>
      <data key="d2">问道宗的大长老，负责接待五行宗，计划将比赛分为四个境界阶段，担心云芝出战会再次血虐五行宗。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474209</data>
      <data key="d6" />
    </node>
    <node id="五行宗二长老">
      <data key="d0">五行宗二长老</data>
      <data key="d1">character</data>
      <data key="d2">五行宗的长老，对上官羽表达爱慕之情，但被上官羽拒绝。</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-006</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785474209</data>
