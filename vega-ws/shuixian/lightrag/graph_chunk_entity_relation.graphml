    <node id="X教授">
      <data key="d0">X教授</data>
      <data key="d1">character</data>
      <data key="d2">X战警的领导者，拥有强大的心灵感应能力，带领团队对抗天启。&gt;</data>
      <data key="d3">doc-42fe6dbbaf4ee96b3c3d968fc1e517f3-chunk-031</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785473710</data>
