    <node id="河灵斧头">
      <data key="d0">河灵斧头</data>
      <data key="d1">item</data>
      <data key="d2">与三昧真火分类方式有异曲同工之处的物品。</data>
      <data key="d3">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-024</data>
