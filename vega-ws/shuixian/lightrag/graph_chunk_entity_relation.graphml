    </node>
    <node id="吉维尼">
      <data key="d0">吉维尼</data>
      <data key="d1">location</data>
      <data key="d2">法国北部小镇，莫奈晚年居住并在此建造了著名的花园和水园，成为其创作灵感的重要来源。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="日出·印象">
      <data key="d0">日出·印象</data>
      <data key="d1">item</data>
      <data key="d2">莫奈于1872年创作的油画，描绘勒阿弗尔港口的晨雾景象，该作品名称成为“印象派”一词的由来。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
