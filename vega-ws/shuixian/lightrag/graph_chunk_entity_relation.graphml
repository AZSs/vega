    <node id="沙漏">
      <data key="d0">沙漏</data>
      <data key="d1">item</data>
      <data key="d2">云芝用来演示空间跳跃的道具，倒放后辅助两人进行空间跳跃。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-017</data>
