    <edge source="乡正" target="尚家">
      <data key="d8">1.0</data>
      <data key="d9">乡正向陆阳提供尚家的背景信息，推测鹦鹉可能属于尚家。</data>
      <data key="d10">提供信息</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-035</data>
      <data key="d12">unknown_source</data>
