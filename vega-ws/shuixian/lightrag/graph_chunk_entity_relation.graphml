    <node id="师徒关系">
      <data key="d0">师徒关系</data>
      <data key="d1">concept</data>
      <data key="d2">指代碧眼狐狸与玉娇龙之间的传授武学与指导关系，带有复杂的情感与利益纠葛。&gt;</data>
      <data key="d3">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-019</data>
