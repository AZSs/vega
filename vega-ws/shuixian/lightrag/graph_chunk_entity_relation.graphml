      <data key="d12">unknown_source</data>
      <data key="d13">1785473424</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="净衣咒">
      <data key="d8">1.0</data>
      <data key="d9">蛮骨学会净衣咒，使衣服变干净。</data>
      <data key="d10">学习</data>
      <data key="d11">doc-dcc4b221c37bbee6881460ac6550c181-chunk-002</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473424</data>
