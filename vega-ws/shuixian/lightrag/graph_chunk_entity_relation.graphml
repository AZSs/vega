    <node id="炼体">
      <data key="d0">炼体</data>
      <data key="d1">concept</data>
      <data key="d2">陆阳在云芝指导下进行的体质强化修炼方式，通过拎缸、药浴等手段提升身体能力。&lt;SEP&gt;陆阳当前进行的修炼阶段，通过锻炼身体控制力来提升实力。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021&lt;SEP&gt;doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-022</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785471545</data>
      <data key="d6" />
    </node>
    <node id="凡人常识">
      <data key="d0">凡人常识</data>
      <data key="d1">concept</data>
      <data key="d2">云芝为教导陆阳而专门学习的知识领域，包括凡人生活细节，如泡澡水温等。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-021</data>
