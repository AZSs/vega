      <data key="d14" />
    </edge>
    <edge source="冯裁缝" target="妖鸟">
      <data key="d8">1.0</data>
      <data key="d9">冯裁缝是第一个发现妖鸟的人，并向乡正报告了妖鸟的存在。</data>
      <data key="d10">发现,报告</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-032</data>
