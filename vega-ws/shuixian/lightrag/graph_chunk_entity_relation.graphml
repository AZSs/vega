      <data key="d0">先天殿</data>
      <data key="d1">location</data>
      <data key="d2">天门峰顶的殿堂，供奉着先天道人、归元天尊、瀚海道君三座牌位。</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-019</data>
