    </node>
    <node id="魔教执事">
      <data key="d0">魔教执事</data>
      <data key="d1">character</data>
      <data key="d2">延江舵的魔教成员，负责会议事务，特意不点灯以营造魔教氛围，自认为勤恳干坏事。</data>
