    <edge source="蛮骨" target="道魔降世">
      <data key="d8">1.0</data>
      <data key="d9">蛮骨获得道魔降世评价。</data>
      <data key="d10">获得评价</data>
      <data key="d11">doc-7481ec7e871977b5736b57f15e207f14-chunk-028</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473036</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="延江郡">
      <data key="d8">3.0</data>
      <data key="d9">蛮骨是延江郡出身的人才。&lt;SEP&gt;蛮骨在延江郡居住，并在此经营烧烤店，他在后院修炼。&lt;SEP&gt;蛮骨与陆阳等人一同调查延江郡嗜睡事件&gt;</data>
      <data key="d10">位于,出身,同行,居住,归属,调查</data>
      <data key="d11">doc-7481ec7e871977b5736b57f15e207f14-chunk-020&lt;SEP&gt;doc-dcc4b221c37bbee6881460ac6550c181-chunk-003&lt;SEP&gt;doc-dcc4b221c37bbee6881460ac6550c181-chunk-009</data>
