      <data key="d12">unknown_source</data>
      <data key="d13">1785473420</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="上古蛮族血脉">
      <data key="d8">1.0</data>
      <data key="d9">蛮骨激活上古蛮族血脉，体型变大，筋骨强横，不惧疼痛。</data>
      <data key="d10">拥有,激活</data>
      <data key="d11">doc-dcc4b221c37bbee6881460ac6550c181-chunk-035</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473420</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="迟绪龙">
      <data key="d8">1.0</data>
      <data key="d9">蛮骨与陆阳一同对抗迟绪龙和沈进义。</data>
      <data key="d10">战斗</data>
      <data key="d11">doc-dcc4b221c37bbee6881460ac6550c181-chunk-026</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473420</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="大象">
      <data key="d8">1.0</data>
      <data key="d9">大象看到蛮骨后感到恐惧，因蛮骨作为上古蛮族曾猎杀大象，杀气令大象心底发寒。</data>
      <data key="d10">血脉压制</data>
      <data key="d11">doc-dcc4b221c37bbee6881460ac6550c181-chunk-029</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473420</data>
      <data key="d14" />
    </edge>
    <edge source="蛮骨" target="大夏野史">
      <data key="d8">1.0</data>
      <data key="d9">蛮骨出于对历史的兴趣购买了《大夏野史》。</data>
      <data key="d10">购买</data>
      <data key="d11">doc-dcc4b221c37bbee6881460ac6550c181-chunk-019</data>
      <data key="d12">unknown_source</data>
