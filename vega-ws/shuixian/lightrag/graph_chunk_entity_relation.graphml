    <edge source="张观甲" target="张观丙">
      <data key="d8">1.0</data>
      <data key="d9">张观甲与张观丙是兄弟，感情深厚。</data>
      <data key="d10">兄弟关系</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033</data>
