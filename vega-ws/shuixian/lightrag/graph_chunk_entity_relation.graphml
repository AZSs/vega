      <data key="d8">1.0</data>
      <data key="d9">章管家持有剥皮刀，用于剥取受害者皮肤。</data>
      <data key="d10">使用,持有</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-001</data>
