      <data key="d16">蛮骨</data>
    </edge>
    <edge source="四长老" target="陆阳">
      <data key="d8">2.0</data>
      <data key="d9">陆阳来到君子峰拜访四长老，由季鸿文接待。&lt;SEP&gt;四长老告诫陆阳要远离老九，并珍惜跟云芝学习的机会。</data>
      <data key="d10">劝诫,告知,拜访</data>
      <data key="d11">doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-016&lt;SEP&gt;doc-de3fdae3cd2fa5a4c39dcc04c4840b4a-chunk-018</data>
