    <node id="校园图书馆">
      <data key="d0">校园图书馆</data>
      <data key="d1">location</data>
      <data key="d2">学校内提供图书借阅和自习空间的场所。&gt;</data>
      <data key="d3">doc-7481ec7e871977b5736b57f15e207f14-chunk-035</data>
