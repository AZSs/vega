    <node id="虎穴">
      <data key="d0">虎穴</data>
      <data key="d1">location</data>
      <data key="d2">虎妖盘踞的洞穴，陆阳等人在此修炼驱使鬼仆之术，洞穴深处堆有受害者的骨头。</data>
