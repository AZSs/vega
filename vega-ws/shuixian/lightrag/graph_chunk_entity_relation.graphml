    <edge source="妖域" target="妖族">
      <data key="d8">1.0</data>
      <data key="d9">妖族居住在妖域，龙族凤族为霸主。</data>
      <data key="d10">居住</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-016</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="妖域" target="朱厌">
      <data key="d8">1.0</data>
      <data key="d9">朱厌从妖域来到中央大陆，提醒人族大乱将至。</data>
      <data key="d10">来源地</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-033</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="妖域" target="古月居士">
      <data key="d8">1.0</data>
      <data key="d9">古月居士在妖域被龙族公主掳走，强行成亲时逃婚。</data>
      <data key="d10">被掳走</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-023</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472609</data>
      <data key="d14" />
    </edge>
    <edge source="妖域" target="夏帝">
      <data key="d8">1.0</data>
      <data key="d9">夏帝怀疑秦国公与妖域有往来，命令太监总管调查。</data>
      <data key="d10">怀疑,调查</data>
      <data key="d11">doc-8cd11b1c29c0a50ae046f374148d440b-chunk-008</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473977</data>
      <data key="d14" />
    </edge>
    <edge source="人族" target="中央大陆">
      <data key="d8">1.0</data>
      <data key="d9">人族聚集在中央大陆，由大夏王朝代表其正统。</data>
      <data key="d10">聚集</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-015</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="人族" target="大妖">
      <data key="d8">1.0</data>
      <data key="d9">人族既恐惧大妖如同天灾，又崇拜大妖的力量，这种矛盾心态是人族成为大陆霸主的必备要素。</data>
      <data key="d10">崇拜,恐惧</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-029</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="人族" target="上古先民">
      <data key="d8">1.0</data>
      <data key="d9">上古先民是人族的起源，通过开辟修炼之法，为人族生生不息奠定基础。</data>
      <data key="d10">开创,起源</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-029</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785472415</data>
      <data key="d14" />
    </edge>
    <edge source="人族" target="炼化星辰的存在">
      <data key="d8">1.0</data>
      <data key="d9">炼化星辰的存在在上古时期造成大量人族死亡，被视为对人族的威胁。</data>
      <data key="d10">伤害,威胁</data>
      <data key="d11">doc-7481ec7e871977b5736b57f15e207f14-chunk-035</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785473033</data>
      <data key="d14" />
    </edge>
    <edge source="人族" target="不朽仙人">
      <data key="d8">2.0</data>
      <data key="d9">不朽仙人在上古时期出手保护了大部分人族，避免人族断代。&lt;SEP&gt;不朽仙人曾拯救人族，并再次同意拯救人族。</data>
      <data key="d10">保护,拯救</data>
      <data key="d11">doc-7481ec7e871977b5736b57f15e207f14-chunk-035&lt;SEP&gt;doc-03e35e5e0231dcb71cb831e5cbd6e5f5-chunk-006</data>
      <data key="d12">unknown_source</data>
      <data key="d13">1785474499</data>
      <data key="d14" />
    </edge>
    <edge source="妖族" target="中央大陆">
      <data key="d8">1.0</data>
      <data key="d9">妖族与人族、鬼魅并存于世界中，在中央大陆之外活动。</data>
      <data key="d10">并存</data>
      <data key="d11">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-015</data>
      <data key="d12">unknown_source</data>
