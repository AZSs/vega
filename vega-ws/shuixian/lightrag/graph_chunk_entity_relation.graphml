    </edge>
    <edge source="大夏王朝" target="帝城孟家">
      <data key="d8">1.0</data>
      <data key="d9">帝城孟家先祖与夏帝先祖一同建立大夏王朝。</data>
      <data key="d10">参与,建立</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-009</data>
