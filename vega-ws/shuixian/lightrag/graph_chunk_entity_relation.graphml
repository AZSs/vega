      <data key="d8">1.0</data>
      <data key="d9">三叶星辰药询问陆阳的名字，陆阳客气地回应。</data>
      <data key="d10">询问</data>
      <data key="d11">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-023</data>
