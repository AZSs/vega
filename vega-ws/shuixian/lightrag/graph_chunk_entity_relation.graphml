    <node id="师尊">
      <data key="d0">师尊</data>
      <data key="d1">character</data>
      <data key="d2">云芝和陆阳的师尊，被云芝囚禁，声音从封印中传出，曾教导云芝修炼。</data>
      <data key="d3">doc-d09c34b3ad3f457c45dfc869efd5813a-chunk-015</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1785472587</data>
