      <data key="d14" />
    </edge>
    <edge source="炼体" target="陆阳">
      <data key="d8">2.0</data>
      <data key="d9">陆阳从零开始炼体，以锻炼臂力为核心训练内容。&lt;SEP&gt;陆阳正在进行炼体修炼，包括练力气和练控制力。</data>
      <data key="d10">修炼,基础,进行</data>
