    <edge source="三长老" target="巴大爷">
      <data key="d8">1.0</data>
      <data key="d9">三长老劝巴大爷不要追求上官羽，担心师父不同意。</data>
      <data key="d10">劝阻</data>
      <data key="d11">doc-e9584b08a7e6456e2d15fc83fa0e4e8e-chunk-029</data>
