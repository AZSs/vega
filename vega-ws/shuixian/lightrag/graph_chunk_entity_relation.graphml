    <node id="学校">
      <data key="d0">学校</data>
      <data key="d1">location</data>
      <data key="d2">李雷和韩梅梅学习的地方。&gt;</data>
      <data key="d3">doc-4e684bd0f9c3b7977e1ef967541c3c6a-chunk-027</data>
